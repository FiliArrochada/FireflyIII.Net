<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FireflyIIINet</AssemblyName>
    <PackageId>FireflyIIINet</PackageId>
    <OutputType>Library</OutputType>
    <Authors>FiliArrochada</Authors>
    <Company>FiliArrochada</Company>
    <AssemblyTitle>Firefly III API Client</AssemblyTitle>
    <Description>A .NET client library for the Firefly III API.</Description>
    <RootNamespace>FireflyIIINet</RootNamespace>
    <!-- Version tracks the Firefly III API version (Major.Minor.Patch);
         the 4th revision component is bumped for client-only changes against the same API version. -->
    <Version>6.7.8.2</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\FireflyIIINet.xml</DocumentationFile>
    <!-- CS1591: undocumented members (Refit interfaces); CS8073: value-type != null in generated Equals -->
    <NoWarn>$(NoWarn);CS1591;CS8073</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FiliArrochada/FireflyIII.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FiliArrochada/FireflyIII.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>6.7.8.2, client-only fixes against Firefly III API 6.7.8. Clearing a stored value: an update leaves out a null field, so the server keeps what it has; the new ClearedFields.Clear extension (update.Clear(u =&gt; u.TargetDate)) sets a field to null and sends it as null, so a piggy bank's target, a recurrence's end, a tag's date or location, a bill's end and extension dates or a split's optional dates can be removed. Breaking: BillUpdate.EndDate and ExtensionDate are DateTime? (they could never be null). RuleTriggerUpdate gains Prohibited, which the spec leaves out: an edited rule lost its NOT triggers. 6.7.8.1: requests send only what the caller set; the bool/int fields of the *Update models are bool?/int?; *Store active defaults to true; piggy banks send account_id and a currency; responses read numbers as strings, date-times as dates and a null budget CurrencyDecimalPlaces; CategoryUpdate.Notes and Color are three-state.</PackageReleaseNotes>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the repo README as the package readme (referenced by PackageReadmeFile above).
         Path is relative to this project (repo root is two levels up). -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Refit" />
    <!-- Since Refit 14 the reflection request builder is a separate package; referenced here so
         RestService.For<T> works everywhere (on net48 the source-generated stubs are not resolved,
         so reflection is the only path). Keep version-locked to Refit. -->
    <PackageReference Include="Refit.Reflection" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.ComponentModel.Annotations" />
  </ItemGroup>

</Project>
